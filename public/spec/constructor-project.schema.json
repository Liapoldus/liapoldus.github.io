{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liapoldus.github.io/spec/constructor-project.schema.json",
  "title": "Liapoldus Constructor project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "react"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
    "name": { "type": "string", "minLength": 1 },
    "react": { "type": "object", "additionalProperties": false, "required": ["entry"], "properties": { "entry": { "type": "string", "pattern": "^src/" } } },
    "pages": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/pageId" } },
    "components": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{1,61}$" } }
  },
  "$defs": {
    "pageId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }
  }
}
