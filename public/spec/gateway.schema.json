{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liapoldus.github.io/spec/gateway.schema.json",
  "title": "Liapoldus gateway.yaml",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "includes": { "type": "array", "default": [], "items": { "type": "string" } },
    "variables": { "type": "object", "default": {}, "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "secrets": { "type": "object", "default": {}, "additionalProperties": { "type": "string", "pattern": "^(env:|file:)" } },
    "registry": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } },
    "sites": { "type": "object", "default": {}, "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string" } } } },
    "listeners": { "type": "object", "default": {}, "additionalProperties": { "$ref": "#/$defs/listener" } },
    "upstreams": { "type": "object", "default": {}, "additionalProperties": { "$ref": "#/$defs/upstream" } },
    "tlsProfiles": { "type": "object", "default": {}, "additionalProperties": { "$ref": "#/$defs/tlsProfile" } },
    "tlsIssuers": { "type": "object", "default": {}, "additionalProperties": { "$ref": "#/$defs/tlsIssuer" } },
    "authPolicies": { "type": "object", "default": {}, "additionalProperties": { "$ref": "#/$defs/authPolicy" } },
    "dataProviders": { "type": "object", "default": {}, "additionalProperties": { "$ref": "#/$defs/dataProvider" } },
    "wafPolicies": { "type": "object", "default": {}, "additionalProperties": { "$ref": "#/$defs/wafPolicy" } },
    "rateLimits": { "type": "object", "default": {}, "additionalProperties": { "$ref": "#/$defs/rateLimit" } },
    "captchaProviders": { "type": "object", "default": {}, "additionalProperties": { "$ref": "#/$defs/captchaProvider" } },
    "plugins": { "type": "object", "default": {}, "additionalProperties": { "$ref": "#/$defs/plugin" } },
    "management": { "$ref": "#/$defs/management" },
    "logging": { "$ref": "#/$defs/logging" },
    "metrics": { "$ref": "#/$defs/metrics" },
    "tracing": { "$ref": "#/$defs/tracing" }
  },
  "$defs": {
    "duration": { "type": "string", "pattern": "^[0-9]+(?:ns|us|µs|ms|s|m|h|d)$" },
    "size": { "type": ["integer", "string"], "pattern": "^[0-9]+(?:KiB|MiB|GiB)?$", "minimum": 0 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "matcher": { "type": "object", "additionalProperties": false, "properties": { "host": { "$ref": "#/$defs/stringMatcher" }, "method": { "$ref": "#/$defs/stringMatcher" }, "path": { "$ref": "#/$defs/pathMatcher" }, "headers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/stringMatcher" } }, "query": { "type": "object", "additionalProperties": { "$ref": "#/$defs/stringMatcher" } }, "sourceIp": { "$ref": "#/$defs/stringMatcher" }, "destinationPort": { "$ref": "#/$defs/stringMatcher" }, "sni": { "$ref": "#/$defs/stringMatcher" }, "alpn": { "$ref": "#/$defs/stringMatcher" }, "tls": { "type": "object", "additionalProperties": false, "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } }, "requestSize": { "$ref": "#/$defs/comparison" }, "connectionAge": { "$ref": "#/$defs/comparison" }, "geo": { "$ref": "#/$defs/geoMatcher" }, "asn": { "$ref": "#/$defs/asnMatcher" }, "all": { "type": "array", "items": { "$ref": "#/$defs/matcher" } }, "any": { "type": "array", "items": { "$ref": "#/$defs/matcher" } }, "not": { "$ref": "#/$defs/matcher" } } },
    "stringMatcher": { "oneOf": [{ "type": "string" }, { "type": "array", "minItems": 1, "items": { "type": "string" } }, { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "exact": { "type": "string" }, "prefix": { "type": "string" }, "regex": { "type": "string" }, "exists": { "type": "boolean" }, "in": { "type": "array", "items": { "type": "string" } }, "notIn": { "type": "array", "items": { "type": "string" } } } }] },
    "pathMatcher": { "oneOf": [{ "$ref": "#/$defs/stringMatcher" }, { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "exact": { "type": "string", "pattern": "^/" }, "prefix": { "type": "string", "pattern": "^/" }, "regex": { "type": "string" } } }] },
    "comparison": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "gt": {}, "gte": {}, "lt": {}, "lte": {} } },
    "geoMatcher": { "type": "object", "additionalProperties": false, "required": ["provider"], "properties": { "provider": { "$ref": "#/$defs/name" }, "country": { "$ref": "#/$defs/stringMatcher" }, "city": { "$ref": "#/$defs/stringMatcher" } } },
    "asnMatcher": { "type": "object", "additionalProperties": false, "required": ["provider"], "properties": { "provider": { "$ref": "#/$defs/name" }, "in": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "notIn": { "type": "array", "items": { "type": "integer", "minimum": 0 } } } },
    "listener": { "type": "object", "additionalProperties": false, "required": ["type", "address"], "properties": { "type": { "enum": ["http", "tcp", "udp"] }, "address": { "type": "string" }, "tls": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "enum": ["terminate", "passthrough"] } } }] }, "limits": { "$ref": "#/$defs/listenerLimits" }, "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } }, "rules": { "type": "array", "items": { "$ref": "#/$defs/route" } } }, "allOf": [{ "if": { "properties": { "type": { "const": "http" } } }, "then": { "required": ["routes"] }, "else": { "required": ["rules"] } }] },
    "listenerLimits": { "type": "object", "additionalProperties": false, "properties": { "connections": { "type": "integer", "minimum": 1, "default": 10000 }, "bytesPerSecond": { "$ref": "#/$defs/size", "default": 0 }, "datagramsPerSecond": { "type": "integer", "minimum": 0, "default": 0 }, "idleTimeout": { "$ref": "#/$defs/duration", "default": "60s" } } },
    "route": { "type": "object", "additionalProperties": false, "required": ["then"], "properties": { "when": { "$ref": "#/$defs/matcher" }, "then": { "$ref": "#/$defs/action" }, "else": { "$ref": "#/$defs/action" }, "default": { "$ref": "#/$defs/action" } } },
    "action": { "type": "object", "additionalProperties": false, "properties": { "site": { "$ref": "#/$defs/name" }, "proxy": { "$ref": "#/$defs/name" }, "plugin": { "$ref": "#/$defs/pluginTarget" }, "redirect": { "$ref": "#/$defs/redirect" }, "deny": { "$ref": "#/$defs/deny" }, "challenge": { "$ref": "#/$defs/challenge" }, "auth": { "$ref": "#/$defs/name" }, "waf": { "$ref": "#/$defs/name" }, "rateLimit": { "$ref": "#/$defs/name" }, "rewrite": { "$ref": "#/$defs/rewrite" }, "headers": { "$ref": "#/$defs/headerActions" }, "cors": { "$ref": "#/$defs/cors" }, "cache": { "$ref": "#/$defs/cachePolicy" }, "compression": { "type": "array", "items": { "enum": ["br", "gzip"] }, "uniqueItems": true } } },
    "pluginTarget": { "type": "object", "additionalProperties": false, "required": ["instance", "capability"], "properties": { "instance": { "$ref": "#/$defs/name" }, "capability": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" }, "context": { "$ref": "#/$defs/pluginContext" } } },
    "redirect": { "type": "object", "additionalProperties": false, "properties": { "scheme": { "enum": ["http", "https"] }, "host": { "type": "string" }, "path": { "type": "string", "pattern": "^/" }, "preserveQuery": { "type": "boolean", "default": true }, "status": { "enum": [301, 302, 307, 308], "default": 308 } } },
    "deny": { "type": "object", "additionalProperties": false, "properties": { "status": { "type": "integer", "minimum": 400, "maximum": 599, "default": 403 }, "code": { "type": "string", "default": "forbidden" } } },
    "challenge": { "type": "object", "additionalProperties": false, "required": ["provider"], "properties": { "provider": { "$ref": "#/$defs/name" } } },
    "rewrite": { "type": "object", "additionalProperties": false, "required": ["regex", "replacement"], "properties": { "regex": { "type": "string" }, "replacement": { "type": "string", "pattern": "^/" } } },
    "headerActions": { "type": "object", "additionalProperties": false, "properties": { "set": { "type": "object", "additionalProperties": { "type": "string" } }, "setIfAbsent": { "type": "object", "additionalProperties": { "type": "string" } }, "delete": { "type": "array", "items": { "type": "string" } } } },
    "headerActionsWrapper": { "type": "object", "additionalProperties": false, "properties": { "response": { "$ref": "#/$defs/headerActions" } } },
    "cors": { "type": "object", "additionalProperties": false, "required": ["origins"], "properties": { "origins": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "methods": { "type": "array", "default": ["GET", "HEAD", "POST"], "items": { "type": "string" } }, "headers": { "type": "array", "default": [], "items": { "type": "string" } }, "exposeHeaders": { "type": "array", "default": [], "items": { "type": "string" } }, "credentials": { "type": "boolean", "default": false }, "maxAge": { "$ref": "#/$defs/duration", "default": "0s" } } },
    "cachePolicy": { "type": "object", "additionalProperties": false, "required": ["visibility"], "properties": { "visibility": { "enum": ["public", "private", "no-store"] }, "maxAge": { "$ref": "#/$defs/duration" } } },
    "cachePolicyWrapper": { "type": "object", "additionalProperties": false, "properties": { "static": { "$ref": "#/$defs/cachePolicy" } } },
    "upstream": { "type": "object", "additionalProperties": false, "properties": { "targets": { "type": "array", "default": [], "items": { "type": "object", "additionalProperties": false, "required": ["address"], "properties": { "address": { "type": "string" }, "weight": { "type": "integer", "minimum": 1, "default": 1 } } } }, "discovery": { "type": "object", "additionalProperties": false, "required": ["dns"], "properties": { "dns": { "type": "string" }, "interval": { "$ref": "#/$defs/duration", "default": "30s" } } }, "healthCheck": { "type": "object", "additionalProperties": false, "properties": { "path": { "type": "string" }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "interval": { "$ref": "#/$defs/duration", "default": "10s" }, "timeout": { "$ref": "#/$defs/duration", "default": "2s" }, "healthyAfter": { "type": "integer", "minimum": 1, "default": 2 }, "unhealthyAfter": { "type": "integer", "minimum": 1, "default": 3 } } }, "balance": { "enum": ["round-robin", "least-connections", "hash"], "default": "round-robin" }, "hash": { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": { "enum": ["source-ip", "header", "cookie", "query"] }, "name": { "type": "string" } } }, "timeouts": { "type": "object", "additionalProperties": false, "properties": { "connect": { "$ref": "#/$defs/duration", "default": "2s" }, "read": { "$ref": "#/$defs/duration", "default": "30s" }, "write": { "$ref": "#/$defs/duration", "default": "30s" }, "idle": { "$ref": "#/$defs/duration", "default": "60s" } } }, "retry": { "type": "object", "additionalProperties": false, "properties": { "attempts": { "type": "integer", "minimum": 0, "default": 0 }, "on": { "type": "array", "default": [], "items": { "enum": ["connect-failure", "timeout", "status-502", "status-503", "status-504"] } } } } } },
    "tlsProfile": { "type": "object", "additionalProperties": false, "required": ["certificates"], "properties": { "certificates": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "oneOf": [{ "required": ["domains", "issuer"], "properties": { "domains": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "issuer": { "$ref": "#/$defs/name" } } }, { "required": ["cert", "key"], "properties": { "cert": { "type": "string" }, "key": { "type": "string" } } }] } }, "protocols": { "type": "array", "default": ["http/1.1", "h2"], "items": { "enum": ["http/1.1", "h2", "h3"] }, "uniqueItems": true }, "clientAuth": { "type": "object", "additionalProperties": false, "required": ["mode", "ca"], "properties": { "mode": { "enum": ["require", "optional"] }, "ca": { "type": "string" } } }, "securityHeaders": { "type": "object", "additionalProperties": false, "properties": { "strictTransportSecurity": { "type": "string" }, "contentSecurityPolicy": { "type": "string" }, "xContentTypeOptions": { "type": "string" }, "referrerPolicy": { "type": "string" }, "permissionsPolicy": { "type": "string" }, "frameOptions": { "type": "string" } } } } },
    "tlsIssuer": { "type": "object", "additionalProperties": false, "required": ["plugin", "storage", "directory", "account", "challenges"], "properties": { "plugin": { "$ref": "#/$defs/pluginTarget" }, "storage": { "$ref": "#/$defs/name" }, "directory": { "type": "string", "format": "uri" }, "account": { "type": "object", "additionalProperties": false, "required": ["email"], "properties": { "email": { "type": "string", "format": "email" } } }, "challenges": { "type": "object", "additionalProperties": false, "properties": { "http01": { "type": "object", "additionalProperties": false, "required": ["listener"], "properties": { "listener": { "$ref": "#/$defs/name" } } }, "dns01": { "type": "object", "additionalProperties": false, "required": ["secret"], "properties": { "secret": { "type": "string" } } } }, "minProperties": 1 }, "renewal": { "type": "object", "additionalProperties": false, "properties": { "before": { "$ref": "#/$defs/duration", "default": "30d" }, "retry": { "type": "object", "additionalProperties": false, "properties": { "initial": { "$ref": "#/$defs/duration", "default": "5m" }, "max": { "$ref": "#/$defs/duration", "default": "12h" } } } } } } },
    "authPolicy": { "type": "object", "additionalProperties": false, "properties": { "oidc": { "type": "object", "additionalProperties": false, "required": ["issuer", "clientId", "clientSecret", "redirectUri", "cookieSecret"], "properties": { "issuer": { "type": "string", "format": "uri" }, "clientId": { "type": "string" }, "clientSecret": { "type": "string" }, "redirectUri": { "type": "string", "format": "uri" }, "cookieSecret": { "type": "string" }, "scopes": { "type": "array", "default": ["openid"], "items": { "type": "string" } } } }, "jwt": { "type": "object", "additionalProperties": false, "required": ["jwksUrl", "issuers", "audiences"], "properties": { "jwksUrl": { "type": "string", "format": "uri" }, "issuers": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "audiences": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "requiredClaims": { "type": "object", "default": {}, "additionalProperties": {} } } }, "mtls": { "type": "object", "additionalProperties": false, "properties": { "identities": { "type": "object" } } } } },
    "dataProvider": { "type": "object", "additionalProperties": false, "required": ["type", "path"], "properties": { "type": { "const": "mmdb" }, "path": { "type": "string" }, "onError": { "enum": ["allow", "deny"], "default": "deny" } } },
    "wafPolicy": { "type": "object", "additionalProperties": false, "required": ["rules"], "properties": { "rules": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["when", "then"], "properties": { "when": { "$ref": "#/$defs/matcher" }, "then": { "$ref": "#/$defs/action" }, "onError": { "enum": ["allow", "deny"], "default": "deny" } } } } } },
    "rateLimit": { "type": "object", "additionalProperties": false, "required": ["key", "requests", "per", "burst"], "properties": { "key": { "enum": ["source-ip", "header", "cookie", "jwt-subject"] }, "name": { "type": "string" }, "requests": { "type": "integer", "minimum": 1 }, "per": { "$ref": "#/$defs/duration" }, "burst": { "type": "integer", "minimum": 1 } } },
    "captchaProvider": { "type": "object", "additionalProperties": false, "required": ["plugin", "verifyUrl", "secret"], "properties": { "plugin": { "$ref": "#/$defs/pluginTarget" }, "verifyUrl": { "type": "string", "format": "uri" }, "secret": { "type": "string" }, "allowedHosts": { "type": "array", "default": [], "items": { "type": "string" } } } },
    "plugin": { "type": "object", "additionalProperties": false, "required": ["binary", "config", "capabilities"], "properties": { "binary": { "type": "string" }, "config": { "type": "string" }, "args": { "type": "array", "default": [], "items": { "type": "string" } }, "env": { "type": "array", "default": [], "items": { "type": "string" } }, "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" } }, "limits": { "type": "object", "default": { "calls": 100, "timeout": "5s", "memory": "256MiB" }, "additionalProperties": false, "properties": { "calls": { "type": "integer", "minimum": 1, "default": 100 }, "timeout": { "$ref": "#/$defs/duration", "default": "5s" }, "memory": { "$ref": "#/$defs/size", "default": "256MiB" } } }, "restart": { "type": "object", "default": { "enabled": true, "backoff": "1s", "maxBackoff": "30s" }, "additionalProperties": false, "properties": { "enabled": { "type": "boolean", "default": true }, "backoff": { "$ref": "#/$defs/duration", "default": "1s" }, "maxBackoff": { "$ref": "#/$defs/duration", "default": "30s" } } }, "grants": { "type": "object", "default": { "storage": [], "secrets": [] }, "additionalProperties": false, "properties": { "storage": { "type": "array", "items": { "$ref": "#/$defs/name" } }, "secrets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "purpose"], "properties": { "name": { "type": "string" }, "purpose": { "type": "string" }, "domains": { "type": "array", "items": { "type": "string" } } } } } } } } },
    "pluginContext": { "type": "object", "additionalProperties": false, "properties": { "request": { "type": "object", "default": { "method": true, "path": false, "query": false }, "additionalProperties": false, "properties": { "method": { "type": "boolean" }, "path": { "type": "boolean" }, "query": { "type": "boolean" } } }, "headers": { "type": "array", "default": [], "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }, "identity": { "type": "object", "additionalProperties": false, "properties": { "subject": { "type": "boolean" }, "claims": { "type": "array", "items": { "type": "string" } } } }, "body": { "enum": ["none", "json", "bytes"], "default": "none" }, "secrets": { "type": "array", "default": [], "items": { "type": "string" } } } },
    "management": { "type": "object", "additionalProperties": false, "properties": { "address": { "type": "string", "default": "127.0.0.1:9090" }, "serviceAccounts": { "type": "array", "default": [], "items": { "type": "object", "additionalProperties": false, "required": ["id", "role", "keyHash"], "properties": { "id": { "$ref": "#/$defs/name" }, "role": { "const": "platform-admin" }, "keyHash": { "type": "string", "pattern": "^file:" } } } } } },
    "logging": { "type": "object", "additionalProperties": false, "properties": { "format": { "const": "json", "default": "json" }, "access": { "type": "array", "default": ["stdout"], "items": { "enum": ["stdout", "stderr"] } } } },
    "metrics": { "type": "object", "additionalProperties": false, "properties": { "prometheus": { "type": "boolean", "default": true }, "otlp": { "type": "object", "additionalProperties": false, "required": ["endpoint"], "properties": { "endpoint": { "type": "string", "format": "uri" }, "interval": { "$ref": "#/$defs/duration", "default": "15s" } } } } },
    "tracing": { "type": "object", "additionalProperties": false, "properties": { "otlp": { "type": "object", "additionalProperties": false, "required": ["endpoint"], "properties": { "endpoint": { "type": "string", "format": "uri" } } }, "sampling": { "enum": ["parent-based", "always-on", "always-off"], "default": "parent-based" } } }
  }
}
