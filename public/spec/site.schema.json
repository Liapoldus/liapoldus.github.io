{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liapoldus.github.io/spec/site.schema.json",
  "title": "Liapoldus site.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "index": { "type": "string", "default": "index.html", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "spa": { "type": "boolean", "default": false },
    "locales": { "type": "array", "default": [], "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" } },
    "defaultLocale": { "type": "string" },
    "redirects": {
      "type": "array", "default": [], "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "pattern": "^/" },
          "to": { "type": "string", "pattern": "^/" },
          "status": { "type": "integer", "enum": [301, 302, 307, 308], "default": 308 }
        }
      }
    },
    "headers": { "$ref": "gateway.schema.json#/$defs/headerActionsWrapper" },
    "cache": { "$ref": "gateway.schema.json#/$defs/cachePolicyWrapper" }
  },
  "allOf": [{
    "if": { "required": ["defaultLocale"] },
    "then": { "properties": { "locales": { "contains": { "const": { "$data": "1/defaultLocale" } } } } }
  }]
}
