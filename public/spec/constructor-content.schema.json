{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liapoldus.github.io/spec/constructor-content.schema.json",
  "title": "Liapoldus Constructor localized content document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "instances"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "instances": {
      "type": "array",
      "items": { "$ref": "#/$defs/instance" }
    }
  },
  "$defs": {
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pageId", "component", "fields"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pageId": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "fields": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
