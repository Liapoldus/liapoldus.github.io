{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liapoldus.github.io/spec/constructor-site.schema.json",
  "title": "Liapoldus Constructor Site document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "projectId", "name", "pages", "locales"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "projectId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "themeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "pages": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
              "name": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
    }
  }
}
